# Building Blocks marketplace MCP server — environment variables.
# All optional; the server runs unauthenticated (60 GitHub req/hr) with none set.

# --- GitHub auth (pick one path) ---
# Preferred for production: GitHub App (5k-12.5k req/hr per installation)
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY=          # PEM, raw multiline or base64-encoded

# Fallback / local dev: personal access token (5k req/hr)
GITHUB_TOKEN=

# --- Server behavior ---
PORT=9248                    # HTTP port
BB_RATE_LIMIT_PER_MIN=60     # per-IP rate limit (health endpoint exempt)
BB_ADMIN_TOKEN=              # shared secret protecting POST /admin/reload-data

# --- Local development ---
BB_CATALOG_LOCAL_PATH=       # read bb-catalog/ from this directory instead of GitHub
