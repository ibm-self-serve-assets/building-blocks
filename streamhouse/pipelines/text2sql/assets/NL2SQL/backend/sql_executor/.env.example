# ── Target database (the DB the LLM-generated SQL runs against) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASS=secret
DB_SSLMODE=require
DB_SSLROOTCERT=              # path to CA cert (verify-ca / verify-full)

# ── Safety limits ─────────────────────────────────────────────────────────────
MAX_ROWS=100                 # max rows returned per query
STATEMENT_TIMEOUT_MS=30000  # query timeout in milliseconds

# ── EXPLAIN cost gating (disabled by default; set to enable) ──────────────────
# Reject queries whose planner estimated total-cost exceeds this value.
# A rough guide: 10000 ≈ a fast index scan on a large table; 1000000 ≈ a
# full sequential scan on a very large table. Profile on your own workload.
EXPLAIN_MAX_COST=            # e.g. 500000

# Reject queries whose planner row-estimate exceeds this value.
EXPLAIN_MAX_ROWS=            # e.g. 5000000

# ── Connection pool ───────────────────────────────────────────────────────────
# IMPORTANT: POOL_MAX should be >= the Code Engine concurrency setting for this
# service (ce-app.yaml concurrency field).  If POOL_MAX < concurrency, requests
# will queue waiting for a free connection and latency will spike under load.
# Recommended: POOL_MAX = CE concurrency = max parallel SQL requests.
# Also validate that the database's max_connections limit is not breached:
#   total_connections = POOL_MAX * (number of CE instances)
POOL_MIN=1
POOL_MAX=10                  # match Code Engine concurrency per instance

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
