# ── Vector storage backend ────────────────────────────────────────────────────
# Must match the value used during ingestion (embedding/.env).
#
#   opensearch  — queries an OpenSearch k-NN index
#   pgvector    — queries a PostgreSQL pgvector table
#
# When pgvector is selected, the PG_* connection variables below are also
# required (the same database that was used as the pgvector store during ingest).
VECTOR_BACKEND=opensearch        # opensearch | pgvector

# ── OpenSearch (used when VECTOR_BACKEND=opensearch) ──────────────────────────
OS_HOST=localhost
OS_PORT=9200
OS_USER=
OS_PASSWORD=
OS_USE_SSL=false
OS_VERIFY_CERTS=false
OS_INDEX=schema_embeddings

# ── pgvector (used when VECTOR_BACKEND=pgvector) ──────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mydb
PG_USER=myuser
PG_PASSWORD=secret
PG_SSLMODE=require
PG_SSLROOTCERT=                  # required when PG_SSLMODE=verify-ca or verify-full

# ── Embedding provider (must match what was used during ingestion) ─────────────
EMBED_PROVIDER=auto              # auto | watsonx | st
EMBED_MODEL=ibm-granite/granite-embedding-125m-english
EMBED_ST_MODEL=BAAI/bge-base-en-v1.5
ST_DEVICE=cpu

WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=

# ── Retrieval tuning ──────────────────────────────────────────────────────────
TOP_K=5
MIN_SCORE=0.40                   # drop results below this cosine similarity
FK_EXPAND=true                   # auto-expand 1-hop FK relationships (opensearch only)

# ── Re-ranking ────────────────────────────────────────────────────────────────
RERANK_ENABLED=false             # true | false
RERANK_PROVIDER=cross-encoder    # cross-encoder | flashrank | none
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=15                  # initial candidate pool size before re-ranking to TOP_K
RERANK_DEVICE=cpu                # cpu | cuda

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO
