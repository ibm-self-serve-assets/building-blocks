# ── Vector storage backend ────────────────────────────────────────────────────
# This file is used when VECTOR_BACKEND=opensearch.
# Set this to match embedding/.env and schema_retriever/.env.
VECTOR_BACKEND=opensearch        # opensearch | pgvector

# ── OpenSearch connection ──────────────────────────────────────────────────────
OS_HOST=localhost
OS_PORT=9200
OS_USER=
OS_PASSWORD=
OS_USE_SSL=false
OS_VERIFY_CERTS=false
OS_INDEX=schema_embeddings

# Vector dimension — must match your embedding model
# BAAI/bge-base-en-v1.5 or granite-embedding-125m-english → 768
VECTOR_DIM=768
