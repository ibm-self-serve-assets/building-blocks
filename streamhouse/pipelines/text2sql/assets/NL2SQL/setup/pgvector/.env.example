# ── Vector storage backend ────────────────────────────────────────────────────
# This file is used when VECTOR_BACKEND=pgvector.
# Set this to match embedding/.env and schema_retriever/.env.
VECTOR_BACKEND=pgvector          # opensearch | pgvector

# ── PostgreSQL connection ──────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mydb
PG_USER=myuser
PG_PASSWORD=secret
PG_SSLMODE=require
PG_SSLROOTCERT=          # required when PG_SSLMODE=verify-ca or verify-full

# Embeddings table config
PG_SCHEMA=public
PG_TABLE_PREFIX=          # optional prefix, e.g. ai_
VECTOR_DIM=768            # must match your embedding model
SCHEMAS_INCLUDE=          # comma-separated schemas; leave blank to auto-discover
LISTS=100                 # ivfflat lists parameter
