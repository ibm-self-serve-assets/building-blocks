# Developer Edition only: pass this file with `orchestrate server start -e .env`.
# Keep it outside the folders you run evaluations from (the framework auto-loads the nearest .env).
# SaaS users do not need this file: use `orchestrate env add` + `orchestrate env activate --api-key "$(...)"`.
WO_DEVELOPER_EDITION_SOURCE=orchestrate
WO_INSTANCE=https://api.<region>.watson-orchestrate.ibm.com/instances/<instance-id>
WO_API_KEY=<api key for that instance>

# Optional: let the local gateway use watsonx.ai models directly
# WATSONX_APIKEY=<ibm cloud api key>
# WATSONX_SPACE_ID=<space bound to a watsonx.ai Runtime instance>   # or WATSONX_PROJECT_ID
