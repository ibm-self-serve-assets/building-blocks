# ── Vector storage backend ────────────────────────────────────────────────────
# Controls which storage backend embeddings are written to and read from.
# Both services (ingest.py and schema_retriever.py) read this flag.
#
#   opensearch  — store in an OpenSearch k-NN index (recommended for production)
#   pgvector    — store in a PostgreSQL pgvector table (no separate search DB)
#
# When switching backends you must re-run ingestion against the new backend.
# The source database (PostgreSQL / Db2) is unaffected by this setting.
VECTOR_BACKEND=opensearch        # opensearch | pgvector

# ── Source databases ──────────────────────────────────────────────────────────
SOURCE_TYPES=postgresql          # comma-separated: postgresql, db2, or both

# PostgreSQL source
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mydb
PG_USER=myuser
PG_PASSWORD=secret
PG_SSLMODE=require
PG_SSLROOTCERT=                  # path to CA cert (verify-ca / verify-full)
PG_SCHEMA=                       # comma-separated schemas; blank = all

# Db2 source
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USER=
DB2_PASSWORD=
DB2_SSL=false
DB2_SSLCERT=                     # path to .arm/.pem server cert
DB2_DRIVER=auto                  # auto | ibm_db | jdbc
DB2_JDBC_JAR=                    # path to db2jcc4.jar (JDBC fallback)
DB_ALIAS=                        # human label stored in OpenSearch (default: DB2_DATABASE)

# ── OpenSearch target ─────────────────────────────────────────────────────────
OS_HOST=localhost
OS_PORT=9200
OS_USER=
OS_PASSWORD=
OS_USE_SSL=false
OS_VERIFY_CERTS=false
OS_INDEX=schema_embeddings

# ── Embedding provider ────────────────────────────────────────────────────────
EMBED_PROVIDER=auto              # auto | watsonx | st
EMBED_MODEL=ibm-granite/granite-embedding-125m-english
EMBED_ST_MODEL=BAAI/bge-base-en-v1.5
ST_DEVICE=cpu

# watsonx (required when EMBED_PROVIDER=watsonx or auto with these set)
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
VECTOR_DIM=                      # override only if model not in built-in table

# ── Ingestion tuning ──────────────────────────────────────────────────────────
SCHEMAS_INCLUDE=                 # comma-separated schema names to restrict
SAMPLE_ROW_LIMIT=3               # sample rows per table (0 = disable)
ENUM_ROW_LIMIT=20                # max distinct values per low-cardinality column
BATCH_SIZE=64

# ── Metadata enrichment ───────────────────────────────────────────────────────
METADATA_ENRICHMENT_ENABLED=true   # true | false
METADATA_ENRICHMENT_FILE=          # path to .yaml, .json, or .md metadata definitions

# ── Sample-row masking ────────────────────────────────────────────────────────
# Two independent masking passes run when sample rows are collected.
#
# Pass 1 — Column-name masking (PII_MASK_COLUMNS):
#   Any column whose name contains a PII_PATTERNS substring is masked with
#   [MASKED].  Set PII_MASK_COLUMNS=false to disable this pass entirely
#   (PII_PATTERNS is then ignored).
#
# Pass 2 — Regex value masking (PII_MASK_VALUES):
#   Values that *look like* sensitive data (email addresses, phone numbers,
#   IPv4 addresses, credit-card numbers) are replaced with a type label such
#   as <email> or <phone>, regardless of the column name.
#   Set PII_MASK_VALUES=false to disable this pass.
#
# To disable ALL masking: set both to false.
# To rely only on column names: set PII_MASK_VALUES=false.
# To rely only on value patterns: set PII_MASK_COLUMNS=false.

PII_MASK_COLUMNS=true            # true | false
PII_PATTERNS=ssn,email,phone,card  # used only when PII_MASK_COLUMNS=true
PII_MASK_VALUES=true             # true | false
