# =============================================================================
# schema-retriever — environment variables
# Copy to .env and fill in values. Never commit the filled-in .env file.
# =============================================================================

# ---------------------------------------------------------------------------
# OpenSearch (IBM Cloud OpenSearch or self-hosted)
# ---------------------------------------------------------------------------
OS_HOST=your-opensearch-hostname.databases.appdomain.cloud
OS_PORT=30200
OS_USER=admin
OS_PASSWORD=
OS_USE_SSL=true
OS_VERIFY_CERTS=true
OS_INDEX=schema_embeddings

# ---------------------------------------------------------------------------
# Embedding provider  (choose ONE block)
# ---------------------------------------------------------------------------

# -- Option A: IBM watsonx.ai (recommended for production) --
EMBED_PROVIDER=watsonx
EMBED_MODEL=ibm-granite/granite-embedding-125m-english
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=

# -- Option B: sentence-transformers (local, no API key needed) --
# EMBED_PROVIDER=st
# EMBED_ST_MODEL=BAAI/bge-base-en-v1.5
# ST_DEVICE=cpu

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
TOP_K=5
MIN_SCORE=0.40
FK_EXPAND=true

# -- Re-ranking --
RERANK_ENABLED=false
RERANK_PROVIDER=cross-encoder
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=15
RERANK_DEVICE=cpu

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
