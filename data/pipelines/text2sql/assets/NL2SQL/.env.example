# =============================================================================
# NL2SQL — consolidated environment variables
# =============================================================================
# Copy this file to NL2SQL/.env and fill in your values.
# This single file is read by all three modules:
#   • setup          (python setup.py)
#   • embedding      (python embedding/ingest.py)
#   • schema-retriever  (uvicorn schema_retriever:app)
#   • sql-executor      (uvicorn tool_sql_executor:app)
#
# Each module only reads the variables it needs — unused variables are ignored.
# Never commit the filled-in .env file.
# =============================================================================


# ── Vector storage backend ────────────────────────────────────────────────────
# Controls which backend is used for storing and retrieving embeddings.
# Must be the same value across setup, embedding, and schema-retriever.
#
#   opensearch  — IBM Cloud OpenSearch or self-hosted (recommended)
#   pgvector    — PostgreSQL with pgvector extension
#
VECTOR_BACKEND=opensearch          # opensearch | pgvector


# ── OpenSearch (used when VECTOR_BACKEND=opensearch) ──────────────────────────
OS_HOST=localhost
OS_PORT=9200
OS_USER=
OS_PASSWORD=
OS_USE_SSL=false
OS_VERIFY_CERTS=false
OS_INDEX=schema_embeddings
VECTOR_DIM=768                     # must match embedding model (granite/bge → 768)


# ── PostgreSQL vector store (used when VECTOR_BACKEND=pgvector) ───────────────
# Also used as the pgvector SOURCE when embedding PostgreSQL databases.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mydb
PG_USER=myuser
PG_PASSWORD=secret
PG_SSLMODE=require
PG_SSLROOTCERT=                    # path to CA cert (verify-ca / verify-full)
PG_SCHEMA=public                   # schema that holds the pgvector embeddings table
PG_TABLE_PREFIX=                   # optional prefix, e.g. ai_
LISTS=100                          # ivfflat lists parameter (setup_pgvector)


# ── Source databases (embedding only) ─────────────────────────────────────────
SOURCE_TYPES=postgresql            # comma-separated: postgresql, db2, or both

# PostgreSQL source (the database whose schema is being embedded)
# If it is the same host as the pgvector store above, the PG_* vars are shared.

# Db2 source
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USER=
DB2_PASSWORD=
DB2_SSL=false
DB2_SSLCERT=                       # path to .arm/.pem server cert
DB2_DRIVER=auto                    # auto | ibm_db | jdbc
DB2_JDBC_JAR=                      # path to db2jcc4.jar (JDBC fallback)
DB_ALIAS=                          # human label stored in OpenSearch (default: DB2_DATABASE)


# ── Embedding provider ────────────────────────────────────────────────────────
# Used by both embedding/ingest.py and schema_retriever — must match.
EMBED_PROVIDER=auto                # auto | watsonx | st
EMBED_MODEL=ibm-granite/granite-embedding-125m-english
EMBED_ST_MODEL=BAAI/bge-base-en-v1.5
ST_DEVICE=cpu

# watsonx.ai credentials (required when EMBED_PROVIDER=watsonx or auto)
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=


# ── Ingestion tuning (embedding only) ─────────────────────────────────────────
SCHEMAS_INCLUDE=                   # comma-separated schema names to restrict; blank = all
SAMPLE_ROW_LIMIT=3                 # sample rows per table (0 = disable)
ENUM_ROW_LIMIT=20                  # max distinct values per low-cardinality column
BATCH_SIZE=64

# ── Metadata enrichment (embedding only) ──────────────────────────────────────
METADATA_ENRICHMENT_ENABLED=true   # true | false
METADATA_ENRICHMENT_FILE=          # path to .yaml, .json, or .md metadata definitions


# ── Sample-row PII masking (embedding only) ───────────────────────────────────
# Pass 1 — Column-name masking: mask columns whose name contains a PII_PATTERNS token.
# Pass 2 — Regex value masking: mask values that look like emails, phones, IPs, cards.
# Set either to false to disable that pass; set both to false to disable all masking.
PII_MASK_COLUMNS=true              # true | false
PII_PATTERNS=ssn,email,phone,card  # used only when PII_MASK_COLUMNS=true
PII_MASK_VALUES=true               # true | false


# ── Schema retriever tuning (schema-retriever service only) ───────────────────
TOP_K=5
MIN_SCORE=0.40                     # drop results below this cosine similarity
FK_EXPAND=true                     # auto-expand 1-hop FK relationships (opensearch only)

# Re-ranking configuration (schema-retriever service only)
RERANK_ENABLED=false               # true | false (cross-encoder re-ranking)
RERANK_PROVIDER=cross-encoder      # cross-encoder | flashrank | none
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=15                    # initial candidate pool size before re-ranking to TOP_K
RERANK_DEVICE=cpu                  # cpu | cuda


# ── SQL executor — target database (sql-executor service only) ────────────────
# This is the database the LLM-generated SQL runs against (read-only user recommended).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASS=secret
DB_SSLMODE=require
DB_SSLROOTCERT=                    # path to CA cert (verify-ca / verify-full)

# Safety limits
MAX_ROWS=100                       # max rows returned per query
STATEMENT_TIMEOUT_MS=30000         # query timeout in milliseconds

# EXPLAIN cost gating (disabled by default — set a value to enable)
EXPLAIN_MAX_COST=                  # e.g. 500000
EXPLAIN_MAX_ROWS=                  # e.g. 5000000

# Connection pool
# POOL_MAX must be >= Code Engine concurrency per instance to avoid queuing.
POOL_MIN=1
POOL_MAX=5


# ── Service ports & logging ───────────────────────────────────────────────────
# schema-retriever listens on 8080; sql-executor listens on 8000 (CE defaults).
# Override PORT inside each service's Dockerfile / ce-app.yaml if needed.
LOG_LEVEL=INFO
