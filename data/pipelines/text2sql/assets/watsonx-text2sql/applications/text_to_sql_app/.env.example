# Application access
APP_API_KEY=
PORT=8080
CORS_ORIGINS=http://localhost:3000

# IBM Cloud / watsonx.data intelligence
IBM_CLOUD_API_KEY=
WXD_PROJECT_ID=
# Full Text-to-SQL endpoint for your deployment. Do not assume a region-specific endpoint.
TEXT_TO_SQL_ENDPOINT=
# Optional custom CA bundle for requests to IBM endpoints
REQUESTS_CA_BUNDLE=

# Optional SQL execution is disabled by default.
SQL_EXECUTION_ENABLED=false

# IBM Db2 (optional execution target)
DB2_HOSTNAME=
DB2_PORT=50001
DB2_DATABASE=
DB2_SCHEMA=
DB2_USERNAME=
DB2_PASSWORD=
DB2_JDBC_DRIVER_PATH=

# IBM watsonx.data Presto (optional execution target)
PRESTO_HOSTNAME=
PRESTO_PORT=443
PRESTO_USERNAME=
PRESTO_PASSWORD=
PRESTO_CATALOG=
PRESTO_SCHEMA=
PRESTO_CA_BUNDLE=
