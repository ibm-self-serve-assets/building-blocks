# All features are interactive locally with STREAM_MODE=mock.
PORT=4000
SIM_INTERVAL_MS=1700
STREAM_MODE=mock
# kafka = send real schema-governed records to Confluent Cloud via native Kafka protocol.
# Credentials MUST remain server side, never use VITE_ for secrets.
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=
KAFKA_AUTO_CREATE_TOPICS=false
KAFKA_CONSUME_DERIVED=false
# Optional: backend subscribes to actual outputs from your deployed Flink SQL.
KAFKA_RISK_TOPIC=factory-risk-signals
KAFKA_KPI_TOPIC=factory-shift-kpis
# Optional: route simulated maintenance ticket to a real external workflow.
ACTION_WEBHOOK_URL=
ACTION_WEBHOOK_TOKEN=
# Optional real Confluent RTCE MCP endpoint (see docs/cloud-setup.md).
RTCE_MCP_ENDPOINT=
RTCE_MCP_BASIC_TOKEN=
# Google Maps browser key, restricted to your domain/referrer.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
