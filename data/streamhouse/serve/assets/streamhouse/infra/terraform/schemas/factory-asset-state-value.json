{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assetId": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "health": {
      "type": "integer"
    },
    "temperature": {
      "type": "number"
    },
    "vibration": {
      "type": "number"
    },
    "qualityScore": {
      "type": "number"
    },
    "scenario": {
      "type": "string"
    }
