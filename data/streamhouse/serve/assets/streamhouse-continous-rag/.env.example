# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
APP_NAME="FactoryPulse Streamhouse"
APP_ENV=dev
PORT=8080
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Confluent Cloud Kafka cluster credentials
# Get these from: Confluent Cloud > Environment > Cluster > Clients
# ------------------------------------------------------------
CONFLUENT_ENABLED=true
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CONFLUENT_KAFKA_API_KEY=YOUR_KAFKA_API_KEY
CONFLUENT_KAFKA_API_SECRET=YOUR_KAFKA_API_SECRET

# Optional Schema Registry. Recommended for Flink/Tableflow profile.
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=
SERIALIZATION_MODE=plain-json

# ------------------------------------------------------------
# Streamhouse / Continuous RAG behavior
# local = Python worker chunks + embeds continuously and persists embeddings to Kafka
# flink = Confluent Cloud Flink produces the embedding topics; see infra/flink/
# ------------------------------------------------------------
RAG_PIPELINE_MODE=local
RAG_TOP_K=4
RAG_CHUNK_SIZE=850
RAG_CHUNK_OVERLAP=120
RAG_EMBEDDING_DIM=384

# ------------------------------------------------------------
# Optional watsonx.ai grounded generation
# none = deterministic grounded response, no external LLM required
# watsonx = use IBM watsonx.ai text generation
# ------------------------------------------------------------
LLM_PROVIDER=none
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_VERSION=2023-05-29

# ------------------------------------------------------------
# Topic names
# ------------------------------------------------------------
TOPIC_MACHINE_TELEMETRY=factory.machine.telemetry
TOPIC_PRODUCTION_EVENTS=factory.production.events
TOPIC_QUALITY_EVENTS=factory.quality.events
TOPIC_MAINTENANCE_EVENTS=factory.maintenance.events
TOPIC_FACTORY_STATE=factory.state
TOPIC_FACTORY_EXCEPTIONS=factory.exceptions
TOPIC_KNOWLEDGE_RAW=rag.knowledge.raw
TOPIC_KNOWLEDGE_EMBEDDINGS=rag.knowledge.embeddings
TOPIC_QUERY_REQUESTS=rag.query.requests
TOPIC_QUERY_EMBEDDINGS=rag.query.embeddings
