# Environment Template — Carbon + Plotly Dashboard

# ============================================================
# Application Observability using IBM Instana
# .env.example — Copy this file to .env.local and fill in your values.
#
# ⚠️  NEVER commit .env or .env.local to source control.
#     Add .env.local to .gitignore.
#
# ⚠️  CRA requires REACT_APP_* prefix for all variables.
#     After editing this file, restart the dev server.
# ============================================================

# ── Instana Connection ────────────────────────────────────────
# The base URL of your Instana unit (no trailing slash).
# Example: https://instana.example.com
REACT_APP_INSTANA_URL=https://unit0-techzone.150-240-162-27.nip.io

# Your Instana API token.
# Obtain from: Instana UI → Settings → API Tokens → Create API Token
# Required permissions: Read application monitoring, Read traces
# ⚠️  Never commit this value. Use a secrets manager in production.
REACT_APP_INSTANA_TOKEN=

# ── Application Perspective ───────────────────────────────────
# The Application Perspective ID to scope all API calls.
# Obtain from: Instana UI → Applications → [your app] → Settings → copy ID from URL
# Example: aBcDeFgH1234
REACT_APP_APPLICATION_ID=

# Display name for the application (shown in the dashboard Insights summary).
# Example: Online Retail Application
REACT_APP_APPLICATION_NAME=Retail Application

# ── Dashboard Behaviour ───────────────────────────────────────
# Auto-refresh interval in milliseconds (default: 30000 = 30 seconds).
# Set to 0 to disable auto-refresh.
# ⚠️ Must use the exact variable name REACT_APP_REFRESH_INTERVAL (not _MS suffix).
REACT_APP_REFRESH_INTERVAL=30000

# Default lookback window in MINUTES (default: 1440 = 24 hours).
# ⚠️ Must use the exact variable name REACT_APP_DEFAULT_TIME_RANGE (not _TIME_WINDOW_MS).
#    The app reads this as minutes, not milliseconds.
REACT_APP_DEFAULT_TIME_RANGE=1440

# ── CORS Proxy ────────────────────────────────────────────────
# NOTE: The CRA proxy is configured in package.json, NOT in this file.
# Add the following to package.json (top-level):
#
#   "proxy": "https://your-instana-url.example.com"
#
# Then use relative paths in all fetch calls (no hostname prefix):
#   fetch('/api/application-monitoring/metrics/applications', ...)
#
# This causes the CRA dev server to forward all /api/* requests to the
# Instana host server-side, avoiding browser CORS restrictions.
# Restart the dev server after changing the proxy value.
